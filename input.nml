 &monin_obukhov_nml
        neutral = .false.,
        stable_option =  2,
        rich_crit = 10.0,
        zeta_trans =  0.5
/

 &ocean_albedo_nml
        ocean_albedo_option = 2
/

 &ocean_rough_nml
        rough_scheme = 'beljaars'
        roughness_min = 1.e-4
/

 &sat_vapor_pres_nml
        construct_table_wrt_liq = .true.
        construct_table_wrt_liq_and_ice = .true.
/
 &surface_flux_nml
	ncar_ocean_flux = .true.,
	raoult_sat_vap = .true.
/

! &surface_flux_nml
!        gust_min = 1.e-10
!/
&fms2_io_nml
    netcdf_default_format = "netcdf4"
/



